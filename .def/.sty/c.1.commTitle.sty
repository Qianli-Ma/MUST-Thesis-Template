% -------------------------------------------------
% English cover-page helper settings
% -------------------------------------------------
\newlength{\coverValueWidth}
\setlength{\coverValueWidth}{8.8cm}

\newcommand{\coverlabel}[2]{%
    \node[coverInfo] at ($(labelx)+(0,#1)$) {#2};%
}

\newcommand{\covercolon}[1]{%
    \node[coverInfo] at ($(colonx)+(0,#1)$) {：};%
}

\newcommand{\covervalue}[2]{%
    \node[
        coverInfo,
        anchor=north west,
        inner sep=0
    ] at ($(linex)+(0,#1)$)
    {\makebox[\coverValueWidth][c]{#2}};%
}

\newcommand{\coverline}[1]{%
    \draw[line width=0.48pt]
        ($(linex)+(0,#1)$) --
        ($(linex)+(\coverValueWidth,#1)$);%
}

% -------------------------------------------------
% Add title page
% -------------------------------------------------
\newcommand{\addtitlepage}{
    \clearpage
    \thispagestyle{plain}
    \thispagestyle{empty}

    \ifwriteqEn
        % -------------------------------------------------
        % English page: CS&E faculty 範文 cover
        %   - 題目 (Chinese) then Title (English), both flush left, bold
        %   - Chinese field labels: 姓名/學號/學院/課程/專業/指導老師/日期
        %   - No watermark (graduation thesis needs none per 範文)
        % -------------------------------------------------
        % Data positioned at the original GS004en overlay coordinates.
        \begin{tikzpicture}[remember picture,overlay]

            % 題目 (Chinese title, KaiTi, 20pt, regular)
            \node[anchor=north west, inner sep=0, text width=16.5cm,
                  font={\fontsize{20pt}{28pt}\selectfont}]
                at ($(current page.north west)+(2.86cm,-3.30cm)$)
                {題目：\cnTitle};

            % Title (English title, Times New Roman, 20pt, regular)
            \node[anchor=north west, inner sep=0, text width=16.5cm,
                  font={\rmfamily\fontsize{20pt}{28pt}\selectfont}]
                at ($(current page.north west)+(2.86cm,-6.20cm)$)
                {Title: \enTitle};

            % Information-block coordinates (original GS004en form)
            \coordinate (labelx) at ($(current page.north west)+(5.26cm,0)$);
            \coordinate (colonx) at ($(current page.north west)+(7.97cm,0)$);
            \coordinate (linex)  at ($(current page.north west)+(8.63cm,0)$);

            % 姓名
            \coverlabel{-16.24cm}{\makebox[2.4cm][s]{姓\hfill 名}}
            \covercolon{-16.24cm}
            \covervalue{-16.24cm}{\Name}
            \coverline{-16.89cm}

            % 學號
            \coverlabel{-17.35cm}{\makebox[2.4cm][s]{學\hfill 號}}
            \covercolon{-17.35cm}
            \covervalue{-17.35cm}{\StudentNo}
            \coverline{-18.00cm}

            % 學院
            \coverlabel{-18.46cm}{\makebox[2.4cm][s]{學\hfill 院}}
            \covercolon{-18.46cm}
            \covervalue{-18.46cm}{\Faculty}
            \coverline{-19.11cm}

            % 課程
            \coverlabel{-19.57cm}{\makebox[2.4cm][s]{課\hfill 程}}
            \covercolon{-19.57cm}
            \covervalue{-19.57cm}{\Program}
            \coverline{-20.22cm}

            % 專業
            \coverlabel{-20.68cm}{\makebox[2.4cm][s]{專\hfill 業}}
            \covercolon{-20.68cm}
            \covervalue{-20.68cm}{\Major}
            \coverline{-21.33cm}

            % 指導老師
            \coverlabel{-21.79cm}{\makebox[2.4cm][s]{指導老師}}
            \covercolon{-21.79cm}
            \covervalue{-21.79cm}{\Supervisor}
            \coverline{-22.44cm}

            % 日期
            \coverlabel{-22.90cm}{\makebox[2.4cm][s]{日\hfill 期}}
            \covercolon{-22.90cm}
            \covervalue{-22.90cm}{\DateofWriting}
            \coverline{-23.55cm}

        \end{tikzpicture}
        \clearpage

    \else
        % -------------------------------------------------
        % Chinese page: use PDF background exactly as before
        % -------------------------------------------------
        \IfFileExists{\titlefilepath}{
            \begin{tikzpicture}[remember picture,overlay]
                \node[inner sep=0] at (current page.center)
                    {\includegraphics[width=\paperwidth,height=\paperheight]{\titlefilepath}};

                \def\vdis{0.889}
                \coordinate (tpos) at (8cm,-13.2);
                \coordinate (entitlepos) at (0.82 cm,-6.1 cm);

                \node[
                    tl,
                    font={\fontsize{22pt}{\baselineskip}\selectfont},
                    text width=12.5cm
                ] at (1.58cm,-3.29cm) {\cnTitle};

                \node[
                    tl,
                    font={\fontsize{18pt}{\baselineskip}\selectfont},
                    text width=13.5cm
                ] at (0.9cm,-6.16cm) {\enTitle};

                \node[ul] at (tpos) {\Name};
                \node[ul,below=1.12 of c1.center] {\StudentNo};
                \node[ul,below=0.82cm of c1.south] {\Faculty};
                \node[ul,below=0.83cm of c1.south] {\Program};
                \node[ul,below=0.83cm of c1.south] {\Major};
                \node[ul,below=0.83cm of c1.south] {\Supervisor};
                \node[ul,below=0.98cm of c1.south] {\DateofWriting};
            \end{tikzpicture}
        }{%
            不存在,\titlefilepath,文件欠缺!
        }
    \fi
}


% 添加原创声明页
\def\declarefilepath{\resourcePath S023.pdf}
% \def\mySign{\resourcePath mySign.png}
% \def\supervisorSign{\resourcePath supervisorSign.png}
\newcommand{\adddeclarepage}{
    \IfFileExists{\declarefilepath}{
        \clearpage
        \MUSTDeclarationPagetrue
        \thispagestyle{plain}
        \thispagestyle{empty}
        \def\choo{0}
        \ifnum\PublicAfterYears=3\def\choo{0.46}\fi
        \ifnum\PublicAfterYears=0\def\choo{0.92}\fi
            \pagestyle{plain}
            \thispagestyle{empty}
            \begin{tikzpicture}[remember picture,overlay]
                \node[inner sep = 0] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{\declarefilepath}};
                \coordinate (O) at ($(current page.north west) + (3.8cm, - 2.5cm)$);

                % 声明部分
                \node[ul2](n1) at ($(O) + (1 cm, -8.9 cm)$) {\Name};
                \node[ul2,below = 1cm of n1.center,name =n2] {\StudentNo};
                \node[ul2,anchor=center] (n1) at  ($(O) + (11 cm,-8.9 cm)$) {\includegraphics[width=1.5cm]{\mySign}};
                \node[ul2,right = 2cm of n2]{\DateofDeclaration};

                % 授权部分
                \node[ul2,name=R] at ($(O) + (-1.4 cm,-19.35 cm) +(0cm,\choo cm)$) {\icon{\Checkmark}};
                \node[ul2,anchor=center] (n3) at  ($(O) + (1 cm,-23.2 cm)$) {
                    \includegraphics[width=1.5cm]{\mySign}
                }; 
                \node[ul2,anchor=center] (n3) at  ($(O) + (11 cm,-23.2 cm)$) {
                    \includegraphics[width=1.5cm]{\supervisorSign}
                }; 
                \node[ul2 ] at ($(O) + (1.5 cm,-24 cm)$){\DateofSignature};
                \node[ul2,right = 2 cm of c1]{\DateofSignature};
            \end{tikzpicture}
            \clearpage
            \MUSTDeclarationPagefalse
        }{
          不存在,\titlefilepath,文件欠缺!
        }
         \pagestyle{fancy}
}



% 为页面添加尺寸说明
\newlength{\pagewidth}
\newlength{\pageheight}


\newcommand{\addinfo}{
\begin{tikzpicture}[overlay,,remember picture]
\tikzmath{
    \el=\ileft;
    \er=\iright;
}

\ifodd\numexpr\value{page}+1\relax
    \tikzmath{
        \el=\iright;
        \er=\ileft;
    }
\fi

\coordinate (nw) at (current page.north west);
\coordinate (sw) at (current page.south west);
\coordinate (ne) at (current page.north east);
\coordinate (se) at (current page.south east);

\setlength{\pagewidth}{\paperwidth}
\setlength{\pageheight}{\paperheight}
\uselengthunit{cm}
\tikzset{
    lines/.style={red,line width=1.2pt, {<[length=6pt].<}-{>.>[length=6pt]}},
    linenoa/.style={red,opacity=0.5,line width=1.2pt },
    % ptxt/.style={pos=0.53,sloped,fill=white,text=red,font=\Large\bfseries }
    ptxt/.style={pos=0.53,sloped,fill=white,text=red,font={\normalfont\Large\bfseries}}
}
\draw [lines] ($(nw)+(\el cm,0)$) -- ($(sw)+(\el cm,0)$) node [ptxt,below,pos=0.43] {\printlength{\pageheight}};
\draw [lines] ($(ne)+(-\er cm,0)$) -- ($(se)+(-\er cm,0)$) ;
\draw [lines]($(nw)+(0,-15 cm)$) -- ($(ne)+(0, -15 cm)$) node [ptxt] {\printlength{\pagewidth}};
\draw [lines] ($(nw)+(0 ,-20 cm)$) -- ($(nw)+(\el cm,-20 cm)$) node [ptxt] {\el cm};
\draw [lines] ($(ne)+(0 ,-20cm)$) -- ($(ne)+(-\er cm,-20cm)$) node [ptxt,above] {\er cm};
\draw [lines] ($(nw)+(2cm ,0)$) -- ($(nw)+(2 cm,-2.5 cm)$) node [ptxt,above] {2.5 cm};
\draw [lines] ($(sw)+(2cm ,0)$) -- ($(sw)+(2 cm,2.5 cm)$) node [ptxt,above] {2.5 cm};
\draw [linenoa]($(nw)+(0,-2.5cm)$) -- ($(ne)+(0, -2.5 cm)$);
\draw [linenoa]($(sw)+(0,2.5cm)$) -- ($(se)+(0, 2.5 cm)$);
\end{tikzpicture}
}
