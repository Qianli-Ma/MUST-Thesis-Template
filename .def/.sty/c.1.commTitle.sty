% -------------------------------------------------
% TikZ styles
% -------------------------------------------------
\tikzset{
    tl/.style={
        inner sep=0,
        anchor=north west,
        align=left
    },
    ul/.style={
        inner sep=0,
        anchor=center,
        font={\cnfz},
        minimum height=1pt,
        name=c1
    },
    ul2/.style={
        inner sep=0,
        anchor=base,
        font={\fontsize{11pt}{\baselineskip}\selectfont},
        align=center,
        text width=8cm,
        name=c1
    },
    coverTitle/.style={
        anchor=north west,
        inner sep=0,
        font={\rmfamily\mdseries\fontsize{18pt}{1.8\baselineskip}\selectfont}
    },
    coverInfo/.style={
        anchor=north west,
        inner sep=0,
        font={\rmfamily\mdseries\fontsize{16pt}{18pt}\selectfont}
    }
}

% -------------------------------------------------
% Cover-page file paths
