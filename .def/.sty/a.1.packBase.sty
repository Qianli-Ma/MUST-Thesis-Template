% 如果写作语言是英文时,加载随机文字宏包
\ifwriteqEn
    % lipsum 宏包提供了一些命令和环境，用于生成英文占位符文本。
    \RequirePackage{lipsum}
    \edef\txtHere#1{\lipsum[#1]}
\else
    % zhlipsum 宏包提供了一些命令和环境，用于生成中文占位符文本。以下是一些常用的命令和环境：
    % \zhlipsum：生成一段中文占位符文本。可以通过可选参数指定生成的段落数，默认为 1。例如，\zhlipsum[2] 将生成两个段落的占位符文本。
    % zhpangram：生成一个中文的“打字练习句子”，包含所有常用的汉字。例如，\zhpangram 将生成一个打字练习句子。
    \RequirePackage{zhlipsum}
    \def\txtHere#1{\zhlipsum#1}
\fi


