\RequirePackage[yyyymmdd]{datetime}
% 用于声明原创的日期时间格式
\newdateformat{dateb}{\THEYEAR/\THEMONTH/\THEDAY}
\ifwriteqEn
    % 用于英文扉页日期的时间格式
    \newdateformat{datea}{\monthname, \THEYEAR}
    % 用于英文致谢落款的时间格式
    \newdateformat{datek}{\THEYEAR/\THEMONTH/\THEDAY}
\else
    % 用于中文扉页日期的时间格式
    \newdateformat{datea}{\THEYEAR 年\THEMONTH 月}
    % 用于中文致谢落款的时间格式
    \newdateformat{datek}{\THEYEAR 年\THEMONTH 月\THEDAY 日}
\fi


% 逻辑语句支持包
\RequirePackage{ifthen}

% 自定义命令支持包 （已经打包进 latex2e 格式，无需加载）
\RequirePackage{xparse}

% 自定义字体大小命令 \fz
\NewDocumentCommand{\fz}{O{14pt} O{1.625}}{%
  \linespread{#2}\selectfont% set baselinestretch first
  \fontsize{#1}{\baselineskip}\selectfont% then set font size (use current \baselineskip)
}


% 自定义英文字体大小命令 \enfz
