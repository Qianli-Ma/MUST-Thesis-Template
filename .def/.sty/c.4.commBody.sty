\let\oldquote\quote
\let\endoldquote\endquote
\renewenvironment{quote}
{\oldquote\vspace{-1em}}
{\endoldquote}


% 添加校徽 logo 宏命令设置
\RequirePackage{eso-pic}
\newif\ifMUSTDeclarationPage
\newcommand\addBackgroundPic[1]{%
\AddToShipoutPicture{
    \put(0,0){%
        \parbox[b][\paperheight]{\paperwidth}{%
            \ifMUSTDeclarationPage
            \else
            \vfill
            % 页面奇偶页边距对称的情况下
            \centering
            \ifprint
                \ifodd\numexpr\value{page}+1\relax
                   \hspace{-1.5cm}
                \else
                    \hspace{1.5cm}
                \fi
            \else
                \hspace{1.5cm}
            \fi
            \includegraphics[width=0.86\textwidth,keepaspectratio]{#1}%
            \vfill
            \fi
            }
        }
    }
}
 

\AtBeginDocument{
    \RequirePackage{ragged2e} % 引入宏包
    \justifying % 设定为两端对齐
    % 設置表格行高
    \renewcommand{\arraystretch}{1.2}
    \ifwriteqEn
        % 清空页眉
        \fancyhead{}
        \enfz
    \else
        % resetCEfancyhf 命令在文件 < ./.def/b.2.setLayout.sty >
        \resetCEfancyhf
        \cnfz
    \fi
    % 将表格的行高缩小为原始高度的一半。
    % \renewcommand\arraystretch{0.5}
    \ifwm\addBackgroundPic{\resourcePath mustlogo.jpg}\fi
    % 插入扉页
    \iftp\addtitlepage\fi
    % % 插入声明原创页
    \ifdp\adddeclarepage\fi
    % 前置部分 (摘要、目录、图/表目录) 页眉设置, 符合规范第 4.2.4 条:
    %   左上角 = 论文标题 (\enShortTitle); 右上角 = 本页所在章节名 (\leftmark,
    %   由 \setcnchapter/\setenchapter 的 \markboth 设定), 使中文摘要页显示
    %   「摘 要」、英文摘要页显示「Abstract」。正文页由 \resetCEfancyhf 另行设定。
    \ifwriteqEn
        % \pagestyle{fancy}
        \fancyhead[L]{\fontsize{10pt}{10pt}\selectfont\enShortTitle}
        \fancyhead[R]{\fontsize{10pt}{10pt}\selectfont\leftmark}
    \fi
}
