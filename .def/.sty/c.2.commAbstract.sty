\ifwriteqEn
    \def\hdis{-6.9}
\else
    \def\hdis{-3.38}
\fi

\newif\ifabstractstarted
\abstractstartedfalse

\newcommand{\setcnchapter}[1]{%
    \chapter*{#1}%
    \markboth{#1}{}%
    \addcontentsline{toc}{chapter}{\hspace{\hdis em}\textbf{#1}}%
}

\newcommand{\setenchapter}[1]{%
    \chapter*{\fontsize{18pt}{\baselineskip}\selectfont #1}%
    \markboth{#1}{#1}%
    \addcontentsline{toc}{chapter}{\hspace{\hdis em}\textbf{#1}}%
}

% 英文摘要
\newenvironment{abstract@en}[1]{
    \clearpage
    \ifabstractstarted
    \else
        \pagenumbering{Roman}%
        \setcounter{page}{1}%
        \global\abstractstartedtrue
    \fi
    \setenchapter{Abstract}%
    \enfz
    \def\ii{#1}%
    }{
    \par\noindent Keywords: \ii
}

% 中文摘要
\newenvironment{abstract@cn}[1]{
    \clearpage
    \ifabstractstarted
    \else
        \pagenumbering{Roman}%
        \setcounter{page}{1}%
        \global\abstractstartedtrue
    \fi
    \setcnchapter{摘~要}%
    \def\ii{#1}%
    }{
    \par\noindent \textbf{關鍵字：} \ii
}